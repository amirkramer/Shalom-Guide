DATABASE_URL=sqlite+aiosqlite:///./app.db
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ENVIRONMENT=dev
IS_LAMBDA=false
MGX_IGNORE_INIT_ADMIN=1

# OpenAI (used for the AI Itinerary chat)
APP_AI_BASE_URL=https://api.openai.com/v1
APP_AI_KEY=

# Stripe (used for tour/guide booking checkout — test mode key is fine)
STRIPE_SECRET_KEY=

# Tripadvisor Terra API (see services/tripadvisor.py) — restaurant ratings/reviews
# display only, no affiliate commission exists for restaurants. Sign up at
# tripadvisor.com/developers.
TRIPADVISOR_API_KEY=
