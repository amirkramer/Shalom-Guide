VITE_GOOGLE_MAPS_API_KEY=

# Hotel affiliate links (see src/lib/affiliateLinks.ts)
# Booking.com: just the numeric affiliate id from partnerships.booking.com
VITE_BOOKING_AFFILIATE_ID=

# Expedia / trivago: paste the deep-link template generated in your network's
# dashboard (CJ Affiliate for Expedia; Awin/Travelpayouts/Involve Asia for trivago).
# Include the literal text "{TARGET_URL}" where the destination URL should go.
# Left empty, the buttons still work but are untracked (no commission).
VITE_EXPEDIA_AFFILIATE_LINK_TEMPLATE=
VITE_TRIVAGO_AFFILIATE_LINK_TEMPLATE=

# Car rental affiliate link (see src/lib/affiliateLinks.ts)
# Discover Cars: paste the tracking link/text-link generated in your affiliate
# dashboard (discovercars.com/affiliate). Include "{TARGET_URL}" where the
# destination URL should go. Left empty, the button still works, untracked.
VITE_DISCOVER_CARS_AFFILIATE_LINK_TEMPLATE=

# Restaurant reservations (see src/lib/affiliateLinks.ts)
# OpenTable: apply to their affiliate program inside your existing CJ Affiliate
# account (case-by-case approval), then paste the generated deep-link template.
# Only covers Tel Aviv in Israel. Ontopo has no affiliate program (nothing to set).
VITE_OPENTABLE_AFFILIATE_LINK_TEMPLATE=
